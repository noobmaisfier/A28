# Catppuccin Mocha Theme for Sway

set $cursor Bibata-Modern-Ice
set $cursor_size 32
seat * xcursor_theme $cursor $cursor_size

# Palette officielle Catppuccin Mocha

# Base colors
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $pink_dark #885b7c
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe

# Surface colors
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# Window colors for Sway
#                       border    bg        text      indicator child_border
client.focused          $pink_dark $base     $text     $pink_dark $pink_dark
client.focused_inactive $overlay0 $base     $text     $rosewater $overlay0
client.unfocused        $overlay0 $base     $subtext1 $rosewater $overlay0
client.urgent           $red      $base     $red      $overlay0  $red
client.placeholder      $overlay0 $base     $text     $overlay0  $overlay0
client.background       $base

# Colors are now defined in the theme file
# Extra colors for compatibility
set $accent     $pink
set $warning    $yellow
set $error      $red
set $success    $green
set $info       $blue



# Wallpaper: managed by awww (change-theme/set-*.sh shows the theme's fixed
# image, slideshow via the awww-cycle timer).

